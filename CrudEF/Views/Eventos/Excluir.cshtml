@model ArteViva.Models.Evento

@{
    ViewData["Title"] = "Excluir evento";
}

<h2>Excluir evento</h2>
<p>Tem certeza que deseja excluir este evento? Essa ação não pode ser desfeita.</p>

<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>

    <dt class="col-sm-2">Data</dt>
    <dd class="col-sm-10">@Model.DataHora.ToString("dd/MM/yyyy 'às' HH:mm")</dd>

    <dt class="col-sm-2">Local</dt>
    <dd class="col-sm-10">@Model.Local</dd>

    <dt class="col-sm-2">Cidade</dt>
    <dd class="col-sm-10">@(Model.Cidade == null ? "-" : $"{Model.Cidade.Nome} - {Model.Cidade.Uf}")</dd>
</dl>

<form asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Sim, excluir</button>
    <a asp-action="MeusEventos" class="btn btn-secondary">Cancelar</a>
</form>