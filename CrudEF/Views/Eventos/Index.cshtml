@model EventoListaViewModel
@{
    ViewData["Title"] = "Eventos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Eventos</h1>
    <a asp-action="Criar" class="btn btn-primary mt-2 mt-md-0">Cadastrar evento</a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["Sucesso"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-12 col-md-5">
        <select name="cidadeId" asp-items="Model.Cidades" class="form-select">
            <option value="">Todas as cidades</option>
        </select>
    </div>
    <div class="col-12 col-md-5">
        <select name="categoriaId" asp-items="Model.Categorias" class="form-select">
            <option value="">Todas as categorias</option>
        </select>
    </div>
    <div class="col-12 col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
    </div>
</form>

@if (!Model.Eventos.Any())
{
    <div class="alert alert-info" role="alert">Nenhum evento encontrado.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var evento in Model.Eventos)
        {
            <div class="col">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">@(evento.Categoria?.Nome ?? "Sem categoria")</span>
                        <h2 class="card-title h5">@evento.Titulo</h2>
                        <p class="card-text text-muted">@evento.Descricao</p>
                        <ul class="list-unstyled small mb-0">
                            <li class="mb-1"><strong>Data:</strong> @evento.DataHora.ToString("dd/MM/yyyy 'às' HH:mm")</li>
                            <li class="mb-1"><strong>Local:</strong> @evento.Local</li>
                            <li><strong>Cidade:</strong> @(evento.Cidade == null ? "Não informada" : $"{evento.Cidade.Nome} - {evento.Cidade.Uf}")</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <span class="small text-muted">@(evento.Gratuito ? "Evento gratuito" : "Evento pago")</span>
                    </div>
                </article>
            </div>
        }
    </div>
}