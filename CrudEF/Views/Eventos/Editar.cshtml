@model EventoCadastroViewModel
@{
    ViewData["Title"] = "Editar evento";
}

<div class="row justify-content-center">
  <div class="col-md-8">
    <h1 class="h3 mb-4">Editar evento</h1>

    <form asp-controller="EditarEvento" asp-action="Index" asp-route-id="@ViewBag.EventoId" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" maxlength="150" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label"></label>
            <textarea asp-for="Descricao" class="form-control" rows="5" maxlength="2000"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="DataHora" class="form-label"></label>
                <input asp-for="DataHora" type="datetime-local" class="form-control" />
                <span asp-validation-for="DataHora" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Local" class="form-label"></label>
                <input asp-for="Local" class="form-control" maxlength="200" />
                <span asp-validation-for="Local" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CidadeId" class="form-label"></label>
                <select asp-for="CidadeId" asp-items="(SelectList)ViewBag.Cidades" class="form-select">
                    <option value="0">Selecione...</option>
                </select>
                <span asp-validation-for="CidadeId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="CategoriaId" class="form-label"></label>
                <select asp-for="CategoriaId" asp-items="(SelectList)ViewBag.Categorias" class="form-select">
                    <option value="0">Selecione...</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-check mb-4">
            <input asp-for="Gratuito" class="form-check-input" />
            <label asp-for="Gratuito" class="form-check-label"></label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Salvar alterações</button>
            <a asp-controller="Eventos" asp-action="MeusEventos" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
  </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}