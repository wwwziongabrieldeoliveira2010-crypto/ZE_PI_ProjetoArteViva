<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ArteViva</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-arteviva mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">ArteViva</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Eventos" asp-action="Index">Eventos</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Eventos" asp-action="Criar">Cadastrar evento</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Sobre">Sobre</a></li>
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><span class="nav-link">Olá, @User.Identity.Name</span></li>
                        <li class="nav-item">
                            <form asp-controller="Usuarios" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-destaque">Sair</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Login">Entrar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Cadastro">Cadastrar</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="container text-center text-muted my-5">
        <small>&copy; 2026 ArteViva</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>